{
  "name": "clawql-mcp",
  "version": "8.0.0",
  "description": "Agentic Gateway \u2014 Foundational Platform for Auditable Production AI. MCP search + execute over OpenAPI/Discovery (internal GraphQL projection), optional native GraphQL HTTP and gRPC unary sources",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./server-http": "./dist/server-http.js",
    "./graphql-proxy": "./dist/graphql-proxy.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "clawql-mcp": "bin/clawql-mcp.mjs",
    "clawql-mcp-http": "bin/clawql-mcp-http.mjs",
    "clawql-gateway-proxy": "bin/clawql-gateway-proxy.mjs",
    "clawql": "bin/clawql.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "infra/pulumi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git"
  },
  "homepage": "https://github.com/danielsmithdevelopment/ClawQL#readme",
  "bugs": {
    "url": "https://github.com/danielsmithdevelopment/ClawQL/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gcp",
    "google",
    "graphql",
    "openapi",
    "openapi-3",
    "cloudflare",
    "rest",
    "claude",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "providers",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example",
    ".cursor/mcp.json.example"
  ],
  "scripts": {
    "clean": "rm -rf dist packages/clawql-merkle/dist packages/clawql-audit/dist packages/clawql-observability/dist packages/clawql-agents/dist packages/clawql-core/dist packages/clawql-auth/dist packages/clawql-tee/dist packages/clawql-pageindex/dist packages/clawql-codegraph/dist packages/clawql-api/dist packages/clawql-memory/dist packages/clawql-documents/dist packages/clawql-automation/dist packages/clawql-sandbox/dist packages/clawql-data/dist packages/clawql-web/dist packages/mcp-grpc-transport/dist packages/mcp-api-adapter/dist packages/clawql-inference/dist packages/clawql-payments/dist packages/clawql-ouroboros/dist packages/clawql-harness/dist packages/panguard-mcp-bridge/dist packages/clawql-operator/dist packages/clawql-release/dist packages/clawql-ontology/dist",
    "build": "npm run clean && npm run build -w clawql-merkle && npm run build -w clawql-core && npm run build -w clawql-audit && npm run build -w clawql-auth && npm run build -w clawql-observability && npm run build -w clawql-tee && npm run build -w clawql-agents && npm run build -w clawql-pageindex && npm run build -w clawql-codegraph && npm run build -w clawql-api && npm run build -w clawql-memory && npm run build -w clawql-web && npm run build -w clawql-documents && npm run build -w clawql-automation && npm run build -w clawql-sandbox && npm run build -w clawql-data && npm run build -w mcp-grpc-transport && npm run build -w mcp-api-adapter && npm run build -w clawql-payments && npm run build -w clawql-inference && npm run build -w clawql-ouroboros && npm run build -w clawql-harness && npm run build -w panguard-mcp-bridge && npm run build -w clawql-operator && npm run build -w clawql-release && npm run build -w clawql-ontology && tsc",
    "ontology:lint": "npm run build -w clawql-ontology && node packages/clawql-ontology/dist/cli.js lint --dir examples/ontology/entities",
    "ontology:generate": "npm run build -w clawql-ontology && node packages/clawql-ontology/dist/cli.js generate --dir examples/ontology/entities --out generated/ontology",
    "build:turbo": "turbo run build",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build && node scripts/release/prepack-clawql-mcp.mjs",
    "postpack": "node scripts/release/postpack-clawql-mcp.mjs",
    "start": "node dist/server.js",
    "start:http": "node dist/server-http.js",
    "dev": "tsx src/server.ts",
    "graphql": "tsx src/graphql-proxy.ts",
    "fetch-provider-specs": "node scripts/providers/fetch-provider-specs.mjs && node scripts/providers/fetch-google-discovery-directory.mjs",
    "fetch-n8n-openapi": "node scripts/providers/fetch-n8n-openapi.mjs",
    "fetch-linear-schema": "node scripts/providers/fetch-linear-schema.mjs",
    "fetch-google-discovery-directory": "node scripts/providers/fetch-google-discovery-directory.mjs",
    "fetch-all-google-discovery-specs": "node scripts/providers/fetch-all-google-discovery-specs.mjs",
    "fetch-google-top50": "node scripts/providers/fetch-google-top50.mjs",
    "fetch-aws-top50": "node scripts/providers/fetch-aws-top50.mjs",
    "generate-aws-top50-manifest": "node scripts/providers/generate-aws-top50-manifest.mjs",
    "pregenerate-google-top50-graphql": "tsx scripts/providers/pregenerate-google-top50-graphql.ts",
    "refresh-google-top50": "npm run fetch-google-top50 && npm run build && npm run pregenerate-google-top50-graphql",
    "refresh-aws-top50": "node scripts/providers/generate-aws-top50-manifest.mjs && npm run fetch-aws-top50",
    "pregenerate-graphql": "tsx scripts/providers/pregenerate-provider-graphql.ts",
    "import-dotenv-to-vault": "tsx scripts/kubernetes/import-dotenv-to-vault.ts --root .",
    "import-dotenv-to-vault:http": "tsx scripts/kubernetes/import-dotenv-to-vault.ts --root . --http",
    "import-dotenv-to-vault:kubectl": "tsx scripts/kubernetes/import-dotenv-to-vault.ts --root . --kubectl-exec",
    "smoke:atlassian": "node scripts/workflows/smoke-atlassian.mjs",
    "smoke:cloudflare": "node scripts/workflows/smoke-cloudflare.mjs",
    "smoke:github-commits": "npm run build && node scripts/workflows/smoke-github-commits.mjs",
    "smoke:openclaw-bootstrap": "npm run build && node scripts/workflows/smoke-openclaw-bootstrap.mjs",
    "workflow:vault-digest": "npm run build -w clawql-automation && node packages/clawql-automation/dist/workflow/vault-digest/cli.js",
    "nats:worker": "npm run build -w clawql-automation && node packages/clawql-automation/dist/nats/cli.js",
    "nats:bootstrap-consumer": "npm run build -w clawql-automation && node packages/clawql-automation/dist/nats/bootstrap-cli.js",
    "nats:agent-bridge": "npm run build -w clawql-automation && node packages/clawql-automation/dist/nats/agent-bridge-cli.js",
    "grpc:memory-recall": "node scripts/dev/grpc-memory-recall.mjs",
    "clawql:github-repo-description": "npm run build && node scripts/dev/clawql-github-patch-repo-description.mjs",
    "benchmark:tokens": "npm run build && node scripts/workflows/benchmark-provider-tokens.mjs",
    "benchmark:executor-comparison": "npm run build && node scripts/benchmarks/executor-comparison.mjs",
    "benchmark:executor-comparison:live": "npm run build && BENCHMARK_LIVE=1 node scripts/benchmarks/executor-comparison.mjs",
    "benchmark:executor-comparison:multiturn": "npm run build && BENCHMARK_LIVE=1 node scripts/benchmarks/executor-comparison-multiturn.mjs",
    "benchmark:executor-comparison:uniform": "npm run build && node scripts/benchmarks/executor-comparison-uniform-pulls.mjs",
    "generate:executor-cmp-static": "npm run generate:executor-cmp-static -w mcp-api-adapter",
    "openbench:validate": "python3 openbench/validate_tasks.py",
    "openbench:ab": "python3 openbench/scripts/run-ab-compare.py",
    "workflow:multi-provider": "npm run build && node scripts/workflows/workflow-gke-cloudflare-jira.mjs",
    "workflow:complex-release-stack": "npm run build && node scripts/workflows/workflow-complex-release-stack.mjs",
    "workflow:complex-release-stack:mcp": "npm run build && node scripts/workflows/mcp-workflow-complex-release-stack.mjs",
    "workflow:complex-release-stack:mcp:live": "npm run build && WORKFLOW_MCP_EXECUTE=1 node scripts/workflows/mcp-workflow-complex-release-stack.mjs",
    "workflow:gcp-multi": "npm run build && node scripts/workflows/mcp-workflow-gcp-multi.mjs",
    "workflow:gcp-multi:direct": "npm run build && node scripts/workflows/workflow-gcp-multi-direct.mjs",
    "report:gcp-multi-experiment": "node scripts/workflows/report-gcp-multi-experiment.mjs",
    "report:all-providers-benchmark": "npm run build && node scripts/workflows/report-all-providers-workflow-benchmark.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"packages/clawql-merkle/src/**/*.ts\" \"packages/clawql-audit/src/**/*.ts\" \"packages/clawql-observability/src/**/*.ts\" \"packages/clawql-auth/src/**/*.ts\" \"packages/clawql-tee/src/**/*.ts\" \"packages/clawql-agents/src/**/*.ts\" \"packages/clawql-harness/src/**/*.ts\" \"packages/clawql-harness/plugins/**/*.ts\" \"packages/clawql-harness/bench/**/*.ts\" \"packages/clawql-core/src/**/*.ts\" \"packages/clawql-api/src/**/*.ts\" \"packages/clawql-memory/src/**/*.ts\" \"packages/clawql-ontology/src/**/*.ts\" \"packages/clawql-web/src/**/*.ts\" \"packages/clawql-documents/src/**/*.ts\" \"packages/clawql-automation/src/**/*.ts\" \"packages/clawql-sandbox/src/**/*.ts\" \"packages/clawql-data/src/**/*.ts\" \"packages/mcp-grpc-transport/src/**/*.ts\" \"packages/clawql-inference/src/**/*.ts\" \"packages/clawql-payments/src/**/*.ts\" \"packages/clawql-ouroboros/src/**/*.ts\" \"packages/panguard-mcp-bridge/src/**/*.ts\" \"packages/clawql-operator/src/**/*.ts\" \"packages/clawql-release/src/**/*.ts\" \"vitest.config.ts\" --max-warnings 0 --cache --cache-location .eslintcache",
    "lint:fix": "eslint \"src/**/*.ts\" \"packages/clawql-merkle/src/**/*.ts\" \"packages/clawql-audit/src/**/*.ts\" \"packages/clawql-observability/src/**/*.ts\" \"packages/clawql-auth/src/**/*.ts\" \"packages/clawql-tee/src/**/*.ts\" \"packages/clawql-agents/src/**/*.ts\" \"packages/clawql-core/src/**/*.ts\" \"packages/clawql-api/src/**/*.ts\" \"packages/clawql-memory/src/**/*.ts\" \"packages/clawql-ontology/src/**/*.ts\" \"packages/clawql-web/src/**/*.ts\" \"packages/clawql-documents/src/**/*.ts\" \"packages/clawql-automation/src/**/*.ts\" \"packages/clawql-sandbox/src/**/*.ts\" \"packages/clawql-data/src/**/*.ts\" \"packages/mcp-grpc-transport/src/**/*.ts\" \"packages/clawql-inference/src/**/*.ts\" \"packages/clawql-payments/src/**/*.ts\" \"packages/clawql-ouroboros/src/**/*.ts\" \"packages/panguard-mcp-bridge/src/**/*.ts\" \"packages/clawql-operator/src/**/*.ts\" \"packages/clawql-release/src/**/*.ts\" \"vitest.config.ts\" --fix --cache --cache-location .eslintcache",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"packages/clawql-merkle/**/*.{ts,md,json}\" \"packages/clawql-audit/**/*.{ts,md,json}\" \"packages/clawql-observability/**/*.{ts,md,json}\" \"packages/clawql-agents/**/*.{ts,md,json}\" \"packages/clawql-core/**/*.{ts,md,json}\" \"packages/clawql-auth/**/*.{ts,md,json}\" \"packages/clawql-tee/**/*.{ts,md,json}\" \"packages/clawql-pageindex/**/*.{ts,md,json}\" \"packages/clawql-api/**/*.{ts,md,json}\" \"packages/clawql-memory/**/*.{ts,md,json}\" \"packages/clawql-ontology/**/*.{ts,md,json}\" \"packages/clawql-web/**/*.{ts,md,json}\" \"packages/clawql-documents/**/*.{ts,md,json}\" \"packages/clawql-automation/**/*.{ts,md,json}\" \"packages/clawql-sandbox/**/*.{ts,md,json}\" \"packages/mcp-grpc-transport/**/*.{ts,md,json}\" \"packages/clawql-inference/**/*.{ts,md,json}\" \"packages/clawql-payments/**/*.{ts,md,json}\" \"packages/clawql-ouroboros/**/*.{ts,md,json}\" \"packages/clawql-operator/**/*.{ts,md,json}\" \"packages/clawql-release/**/*.{ts,md,json}\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.md\" \"vitest.config.ts\" \"eslint.config.js\" \"tsconfig.json\" \".prettierrc.json\" \"turbo.json\" --cache --cache-location .prettier-cache && npm run format --prefix website",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"packages/clawql-merkle/**/*.{ts,md,json}\" \"packages/clawql-audit/**/*.{ts,md,json}\" \"packages/clawql-observability/**/*.{ts,md,json}\" \"packages/clawql-agents/**/*.{ts,md,json}\" \"packages/clawql-core/**/*.{ts,md,json}\" \"packages/clawql-auth/**/*.{ts,md,json}\" \"packages/clawql-tee/**/*.{ts,md,json}\" \"packages/clawql-pageindex/**/*.{ts,md,json}\" \"packages/clawql-api/**/*.{ts,md,json}\" \"packages/clawql-memory/**/*.{ts,md,json}\" \"packages/clawql-ontology/**/*.{ts,md,json}\" \"packages/clawql-web/**/*.{ts,md,json}\" \"packages/clawql-documents/**/*.{ts,md,json}\" \"packages/clawql-automation/**/*.{ts,md,json}\" \"packages/clawql-sandbox/**/*.{ts,md,json}\" \"packages/mcp-grpc-transport/**/*.{ts,md,json}\" \"packages/clawql-inference/**/*.{ts,md,json}\" \"packages/clawql-payments/**/*.{ts,md,json}\" \"packages/clawql-ouroboros/**/*.{ts,md,json}\" \"packages/clawql-operator/**/*.{ts,md,json}\" \"packages/clawql-release/**/*.{ts,md,json}\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.md\" \"vitest.config.ts\" \"eslint.config.js\" \"tsconfig.json\" \".prettierrc.json\" \"turbo.json\" --cache --cache-location .prettier-cache && npm run format:check --prefix website",
    "release:git-tag": "bash scripts/release/git-release-tag.sh",
    "release:git-tag:push": "bash scripts/release/git-release-tag.sh --push",
    "release:git-backfill-tags": "bash scripts/release/git-backfill-npm-release-tags.sh",
    "release:git-backfill-tags:push": "bash scripts/release/git-backfill-npm-release-tags.sh --push",
    "release:manifest": "node scripts/release/build-release-manifest.mjs"
  },
