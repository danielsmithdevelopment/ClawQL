{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawql.dev/schemas/pageindex-ab/manifest.schema.json",
  "title": "PageIndex A/B freeze manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tag",
    "created_at",
    "harness_commit",
    "spec_path",
    "spec_sha256",
    "model_primary",
    "documents",
    "questions_sha256",
    "decision_rules_version",
    "spent"
  ],
  "properties": {
    "tag": {
      "type": "string",
      "enum": [
        "pageindex-ab-v1",
        "pageindex-ab-v1-candidate",
        "pageindex-ab-v1-hard-candidate"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "harness_commit": { "type": "string", "minLength": 7 },
    "spec_path": { "type": "string" },
    "spec_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_primary": { "type": "string" },
    "model_primary_pinned_id": { "type": "string" },
    "model_frontier_subset": { "type": "string" },
    "judge_model": { "type": "string" },
    "adjudicator_model": { "type": "string" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stratum", "path", "sha256", "token_estimate"],
        "properties": {
          "id": { "type": "string" },
          "stratum": {
            "type": "string",
            "enum": ["well_structured", "converted_pdf", "weakly_structured"]
          },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "token_estimate": { "type": "integer", "minimum": 1 },
          "fits_arm_d": { "type": "boolean" },
          "source_url": { "type": "string" }
        }
      }
    },
    "questions_path": { "type": "string" },
    "questions_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision_rules_version": { "type": "string", "enum": ["0.1", "0.2"] },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "stratum": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" },
    "spent": {
      "type": "boolean",
      "description": "True after the single scored run; further tuning requires v2."
    },
    "predictions": {
      "type": "object",
      "properties": {
        "expected_outcome": { "type": "integer", "enum": [1, 2, 3] },
        "rationale": { "type": "string" },
        "recorded_by": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
