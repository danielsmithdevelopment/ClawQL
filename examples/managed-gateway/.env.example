# Managed Edge Gateway env (docker compose)
#
# Prefer: clawql gateway create --profile local-docker
# which writes a real .env with a generated virtual key (shown once).

CLAWQL_GATEWAY_PORT=8080
CLAWQL_PROVIDER=default

# Required — same secret used for MCP apiKey auth and inference virtual key
CLAWQL_API_KEY=clawql-vk-replace-me

# Host mounts (created by clawql gateway create)
CLAWQL_VAULT_HOST_PATH=./data/vault
CLAWQL_HOME_HOST_PATH=./data/clawql-home

# BYOK provider keys (at least one recommended)
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
