# ConeShare smoke env for docker-compose.idp-smoke.yml (not for production).
SECRET_KEY=clawql-idp-smoke-coneshare-secret-key-not-for-prod
DEBUG=True
SITE_DOMAIN=http://127.0.0.1:8999
DISPLAY_TIME_ZONE=UTC
PDF_PREVIEW_ENGINE=pdfjs
ENABLE_OFFICE_PREVIEW=false
ENABLE_VIDEO_PREVIEW=false
CELERY_WORKER_CONCURRENCY=1
PASSWORD_MIN_LENGTH=8
ENABLED_PASSWORD_VALIDATORS=min_length
DATABASE_URL=postgres://postgres@coneshare-postgres:5432/postgres
REDIS_URL=redis://coneshare-redis:6379
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
SERVER_EMAIL=errors@localhost
ADMINS=Smoke:admin@localhost
SENTRY_DSN=
INTERNAL_API_TOKEN=clawql-idp-smoke-internal
CORE_API_URL=http://coneshare-web:8080
PORT=8080
STORAGE_PATH=/data
MALWARE_SCAN_ENABLED=false
CONESHARE_API_URL=http://coneshare-web:80/api/v1
MCP_TRANSPORT=streamable-http
MCP_PATH=/mcp/sse
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=adminadmin1
DJANGO_SUPERUSER_EMAIL=admin@localhost
