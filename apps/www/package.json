{
  "name": "clawql-landing-page",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "node scripts/generate-agent-assets.mjs",
    "dev": "node scripts/generate-agent-assets.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app/globals.css",
    "tailwindFunctions": [
      "clsx"
    ]
  },
  "dependencies": {
    "@tailwindplus/elements": "0.0.0-insiders.98ea4bc",
    "clsx": "^2.1.1",
    "next": "16.3.6",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "fast-uri": "3.1.8",
    "hono": "4.13.12",
    "js-yaml": "4.3.2",
    "body-parser": "2.3.0",
    "sharp": "0.35.5",
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2"
  }
}
