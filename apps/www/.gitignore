# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated at prebuild (see scripts/generate-agent-assets.mjs)
/public/robots.txt
/public/auth.md
/public/agent-markdown.json
/public/llms.txt
/public/_headers
/public/_redirects
/public/install
/public/install.sh
/public/.well-known/

# Lighthouse CI artifacts
/lighthouse-ci.json
/lighthouse-a11y.json
/lighthouse-report.html
