---
/**
 * FlexSearch dialog (⌘K) — same capability as the former Next docs site.
 * Place once near end of body. Openers use [data-docs-search-open] anywhere.
 */
type Props = {
  variant?: 'dialog' | 'desktop-trigger' | 'mobile-trigger'
}

const { variant = 'dialog' } = Astro.props
---

{
  variant === 'desktop-trigger' ? (
    <button
      type="button"
      data-docs-search-open
      class="docs-chrome flex h-8 w-full max-w-md items-center gap-2 rounded-full bg-white pr-3 pl-2 text-sm text-zinc-600 ring-1 ring-zinc-900/10 transition hover:ring-zinc-900/20 dark:bg-white/5 dark:text-zinc-300 dark:ring-white/10 dark:hover:ring-white/20"
      aria-label="Search documentation"
    >
      <svg
        class="ml-1 size-5 shrink-0 stroke-zinc-500"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12.01 12a4.25 4.25 0 1 0-6.02-6 4.25 4.25 0 0 0 6.02 6Zm0 0 3.24 3.25"
        />
      </svg>
      <span class="truncate">Search documentation…</span>
      <kbd class="ml-auto text-[0.65rem] text-zinc-500 dark:text-zinc-300">
        <kbd class="font-sans">⌘</kbd>
        <kbd class="font-sans">K</kbd>
      </kbd>
    </button>
  ) : variant === 'mobile-trigger' ? (
    <button
      type="button"
      data-docs-search-open
      class="docs-chrome relative flex size-9 items-center justify-center rounded-md text-zinc-600 transition hover:bg-zinc-900/5 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-white/5 dark:hover:text-white"
      aria-label="Search documentation"
    >
      <svg class="size-5 stroke-current" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12.01 12a4.25 4.25 0 1 0-6.02-6 4.25 4.25 0 0 0 6.02 6Zm0 0 3.24 3.25"
        />
      </svg>
    </button>
  ) : (
    <div
      id="docs-search-dialog"
      class="docs-chrome fixed inset-0 z-[70] hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Search documentation"
    >
      <button
        type="button"
        class="absolute inset-0 bg-zinc-400/25 backdrop-blur-sm dark:bg-black/50"
        aria-label="Close search"
        data-docs-search-close
      />
      <div class="relative mx-auto mt-[max(1rem,8vh)] w-[calc(100%-1.5rem)] max-w-xl overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-zinc-900/10 dark:bg-claw-panel dark:ring-white/10">
        <div class="flex items-center gap-2 border-b border-zinc-900/10 px-3 dark:border-white/10">
          <svg
            class="size-5 shrink-0 stroke-zinc-500"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12.01 12a4.25 4.25 0 1 0-6.02-6 4.25 4.25 0 0 0 6.02 6Zm0 0 3.24 3.25"
            />
          </svg>
          <input
            id="docs-search-input"
            type="search"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            placeholder="Search documentation…"
            class="h-12 w-full appearance-none bg-transparent text-zinc-900 outline-none placeholder:text-zinc-500 dark:text-white dark:placeholder:text-zinc-400 [&::-webkit-search-cancel-button]:hidden"
          />
          <button
            type="button"
            class="rounded-md px-2 py-1 text-xs text-zinc-500 ring-1 ring-zinc-900/10 hover:bg-zinc-50 dark:ring-white/10 dark:hover:bg-white/5"
            data-docs-search-close
          >
            Esc
          </button>
        </div>
        <div id="docs-search-results" class="min-h-[4rem]" />
      </div>
    </div>
  )
}

{
  variant === 'dialog' ? (
    <script>
      import { initDocsSearch } from '@/scripts/docs-search'
      initDocsSearch()
    </script>
  ) : null
}
