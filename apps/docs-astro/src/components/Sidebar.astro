---
import { docsMobileShortcuts, docsNavigation } from '@/lib/nav'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'

function linkActive(href: string) {
  const path = href.split('#')[0].replace(/\/$/, '') || '/'
  if (path === '/') return pathname === '/'
  return pathname === path || pathname.startsWith(path + '/')
}

function groupActive(links: { href: string }[]) {
  return links.some((l) => linkActive(l.href))
}
---

<nav class="docs-chrome docs-nav font-sans" aria-label="Documentation">
  <ul role="list" class="lg:hidden mb-6 space-y-1 border-b border-zinc-900/10 pb-4 dark:border-white/10">
    {
      docsMobileShortcuts.map((item) => (
        <li>
          <a
            href={item.href}
            class="block py-1 text-sm text-zinc-600 no-underline transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
            data-nav-close
          >
            {item.title}
          </a>
        </li>
      ))
    }
  </ul>

  <ul role="list" class="space-y-1">
    {
      docsNavigation.map((group) => {
        const open =
          groupActive(group.links) ||
          (pathname === '/' && group.title === 'Getting started')
        return (
          <li class="docs-nav-group">
            <details class="group/details" open={open || undefined}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-md px-1 py-1.5 text-xs font-semibold text-zinc-900 marker:content-none dark:text-white [&::-webkit-details-marker]:hidden">
                <span>{group.title}</span>
                <svg
                  class="size-3.5 shrink-0 text-zinc-400 transition group-open/details:rotate-180"
                  viewBox="0 0 12 12"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 4.5 6 8l3.5-3.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <div class="relative mt-1 ml-1 border-l border-zinc-900/10 pl-3 dark:border-white/10">
                <ul role="list" class="space-y-0.5 pb-3">
                  {group.links.map((link) => {
                    const active = linkActive(link.href)
                    return (
                      <li class="relative">
                        {active ? (
                          <span
                            class="absolute -left-[13px] top-1.5 h-5 w-px bg-claw-cyan"
                            aria-hidden="true"
                          />
                        ) : null}
                        <a
                          href={link.href}
                          aria-current={active ? 'page' : undefined}
                          data-nav-close
                          class:list={[
                            'flex items-center justify-between gap-2 rounded-md py-1 pr-2 text-sm no-underline transition',
                            active
                              ? 'font-medium text-zinc-900 dark:text-white'
                              : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white',
                          ]}
                        >
                          <span class="truncate">{link.title}</span>
                          {link.tag ? (
                            <span class="docs-nav-tag">{link.tag}</span>
                          ) : null}
                        </a>
                      </li>
                    )
                  })}
                </ul>
              </div>
            </details>
          </li>
        )
      })
    }
  </ul>
</nav>
