{
  "name": "clawql-docs-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClawQL docs site (Astro) — migrates docs.clawql.com off Next/OpenNext (ADR 0018)",
  "scripts": {
    "prebuild": "node scripts/import-from-next.mjs",
    "import:next": "node scripts/import-from-next.mjs",
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages-preview": "npm run build && wrangler pages deploy dist --project-name=clawql-docs-astro --branch=main"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^7.4.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5",
    "esbuild": ">=0.28.1"
  }
}
