/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/_next/image
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# HTML must not outlive hashed CSS from a prior deploy (see edge-cache-control.mjs).
/*
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=300
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # CSP script-src: sha256 of known JSON-LD; seal Next flight hashes after OpenNext (docs/website/csp-script-hashes.md)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-7ICrVQWYkT+Qc4xOlrJG/P4oCn7Ozb8Nsu54/qSsfDk=' 'sha256-7ulnTRaQEr/uXIrd53Nwik3QPfjXASxSzJ3SRqKPA0c=' 'sha256-Dl40VvG5WcSB2URVF1nkWgk6N7GcE2nGCVUc6lv7WSk=' 'sha256-HFKoV0EJhLGdsdD3IqTnEAqD/PHa8CXdPl00tOSqdIk=' 'sha256-X6LMGKd3Q+gj/70bU4bNEnfO8K7hvfOlbkMSpnfPs1w=' 'sha256-rnjMUbHXsVx1hSx1ddjcgrGpwvF9sVSPkYFW/Jt5T6A=' 'sha256-t8Z8oVdA65cqZYCnDRKwQ28k8KiVTJs5BmydBa0WK5U=' 'sha256-z9QcgXGHY/v4LLdcUSAGkxtNiXuhMj5ZFdLB9VOFFtQ='; connect-src 'self' https://docs.clawql.com; upgrade-insecure-requests

