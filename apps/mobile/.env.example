# Staging / production API (managed console origin)
EXPO_PUBLIC_CLAWQL_API_BASE=https://cloud.clawql.com
EXPO_PUBLIC_CLAWQL_AUTH_ISSUER=https://cloud.clawql.com

# 1 = offline fixtures for Maestro / local UI (default in npm start)
EXPO_PUBLIC_CLAWQL_FIXTURE=1

# 1 = force reviewer-demo biometric path even outside fixture sign-in
EXPO_PUBLIC_CLAWQL_REVIEWER_BIOMETRIC=0

# EAS project id (set after `eas init`)
EAS_PROJECT_ID=
