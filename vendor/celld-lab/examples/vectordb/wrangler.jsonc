{
  "name": "vectordb",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  // sqlite-vec requires an explicit opt-in before version 1.
  "compatibility_flags": ["sqlite_vec"],
  "durable_objects": {
    "bindings": [{ "name": "PALETTE", "class_name": "Palette" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Palette"] }]
}
