# Lending vertical Compose — copy to lending.env and adjust ([#251](https://github.com/danielsmithdevelopment/ClawQL/issues/251))
#
#   cp docker/compose/lending.env.example docker/compose/lending.env
#   docker compose -f docker/compose/lending.compose.yml --env-file docker/compose/lending.env up -d --build

# Host ports (change if you already use 8080 / 5001 / 8090 / 8095 locally)
CLAWQL_HOST_PORT=8080
DOCLING_HOST_PORT=5001
LANGEXTRACT_HOST_PORT=8090
LABEL_STUDIO_HOST_PORT=8095

# Obsidian vault mount for memory_ingest / memory_recall
CLAWQL_VAULT_HOST_PATH=${HOME}/.ClawQL-lending

# Label Studio CE bootstrap (first login — change in production)
LABEL_STUDIO_PUBLIC_URL=http://localhost:8095
LABEL_STUDIO_USERNAME=admin@localhost
LABEL_STUDIO_PASSWORD=changeme

# After Label Studio is up: Account & Settings → Access Token → paste here, then restart clawql-mcp
CLAWQL_LABEL_STUDIO_API_TOKEN=replace-with-label-studio-personal-access-token

# Shared secret for POST /hitl/label-studio/webhook (required when NODE_ENV=production)
CLAWQL_HITL_WEBHOOK_TOKEN=lending-demo-webhook-secret

# Classifier routing threshold (reference heuristic — train your own for production)
CLASSIFIER_MIN_CONFIDENCE=0.85
