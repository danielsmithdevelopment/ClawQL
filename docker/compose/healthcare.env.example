# Healthcare / clinical referral Compose — copy to healthcare.env and adjust ([#251](https://github.com/danielsmithdevelopment/ClawQL/issues/251))
#
#   cp docker/compose/healthcare.env.example docker/compose/healthcare.env
#   docker compose -f docker/compose/healthcare.compose.yml --env-file docker/compose/healthcare.env up -d --build

# Host ports (offset from lending defaults to allow parallel local stacks)
CLAWQL_HOST_PORT=8180
DOCLING_HOST_PORT=5101
LANGEXTRACT_HOST_PORT=8190
LABEL_STUDIO_HOST_PORT=8195

# Obsidian vault mount for memory_ingest / memory_recall
CLAWQL_VAULT_HOST_PATH=${HOME}/.ClawQL-healthcare

# Label Studio CE bootstrap (first login — change in production)
LABEL_STUDIO_PUBLIC_URL=http://localhost:8195
LABEL_STUDIO_USERNAME=admin@localhost
LABEL_STUDIO_PASSWORD=changeme

# After Label Studio is up: Account & Settings → Access Token → paste here, then restart clawql-mcp
CLAWQL_LABEL_STUDIO_API_TOKEN=replace-with-label-studio-personal-access-token

# Shared secret for POST /hitl/label-studio/webhook (required when NODE_ENV=production)
CLAWQL_HITL_WEBHOOK_TOKEN=healthcare-demo-webhook-secret

# Classifier routing threshold (reference heuristic — train your own for production)
CLASSIFIER_MIN_CONFIDENCE=0.85
