+/// Fixed-width unique tag (must match ClawQL UNIQUE_TAG_WIDTH).
+const UNIQUE_TAG_WIDTH: usize = 64;
+
+fn unique_tag(seed: &str, slot: &str) -> String {
+    let mut raw = format!("{seed}|{slot}|");
+    let mut i = 0usize;
+    while raw.len() < UNIQUE_TAG_WIDTH {
+        let b = (raw.as_bytes()[i % raw.len()] as usize).wrapping_add(i.wrapping_mul(17)) % 36;
+        raw.push(char::from_digit(b as u32, 36).unwrap_or('0'));
+        i += 1;
+    }
+    raw.truncate(UNIQUE_TAG_WIDTH);
+    raw
+}
+
+fn with_unique_suffix(base: &str, tag: &str) -> String {
+    let tag = if tag.len() == UNIQUE_TAG_WIDTH {
+        tag.to_owned()
+    } else {
+        let mut t = tag.to_owned();
+        t.extend(std::iter::repeat('0').take(UNIQUE_TAG_WIDTH.saturating_sub(t.len())));
+        t.truncate(UNIQUE_TAG_WIDTH);
+        t
+    };
+    if base.len() >= UNIQUE_TAG_WIDTH {
+        format!("{}{tag}", &base[..base.len() - UNIQUE_TAG_WIDTH])
+    } else {
+        format!("{base}{tag}")
+    }
+}
+
+fn history_seed(history: &[Message]) -> String {
+    // Prefer the first user text (contains agent id); fall back to history length.
+    for msg in history {
+        if let Message::User { content } = msg {
+            for c in content {
+                if let UserContent::Text(t) = c {
+                    return format!("n{}:{}", history.len(), t.text);
+                }
+            }
+        }
+    }
+    format!("n{}", history.len())
+}
 
