+/// Comma-separated agent counts at which to run a sequential turn-latency probe.
+fn env_probe_at() -> Vec<usize> {
+    match std::env::var("PROBE_AT") {
+        Ok(v) if !v.trim().is_empty() => v
+            .split(',')
+            .filter_map(|s| s.trim().parse::<usize>().ok())
+            .filter(|n| *n > 0)
+            .collect(),
+        _ => Vec::new(),
+    }
+}
+
+fn percentile_ms(samples: &mut [f64], p: f64) -> f64 {
+    if samples.is_empty() {
+        return 0.0;
+    }
+    samples.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+    let idx = ((p / 100.0) * samples.len() as f64).ceil() as usize;
+    let idx = idx.saturating_sub(1).min(samples.len() - 1);
+    samples[idx]
+}
+
+/// Sequential per-agent turn probe (one user message → 2 completions).
+async fn probe_turn_latency(
+    sender: &ChannelSender,
+    finished: &Rc<Cell<u64>>,
+    expected: &mut u64,
+    agent_ids: &[String],
+    sample: usize,
+    probe_turn: usize,
+) -> (f64, f64, f64, usize) {
+    let n = sample.min(agent_ids.len());
+    let mut samples_ms = Vec::with_capacity(n);
+    for id in agent_ids.iter().take(n) {
+        let t0 = Instant::now();
+        sender
+            .send_to_input_queue(user_text(id, probe_turn), &uuid::Uuid::new_v4().to_string())
+            .await
+            .expect("probe send");
+        *expected += 2;
+        wait_for(finished, *expected).await;
+        samples_ms.push(t0.elapsed().as_secs_f64() * 1000.0);
+    }
+    let mean = if samples_ms.is_empty() {
+        0.0
+    } else {
+        samples_ms.iter().sum::<f64>() / samples_ms.len() as f64
+    };
+    let p50 = percentile_ms(&mut samples_ms.clone(), 50.0);
+    let p99 = percentile_ms(&mut samples_ms, 99.0);
+    (p50, p99, mean, n)
+}
