{
  "name": "clawql-landing-page",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "node scripts/generate-agent-assets.mjs",
    "dev": "node scripts/generate-agent-assets.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app/globals.css",
    "tailwindFunctions": [
      "clsx"
    ]
  },
  "dependencies": {
    "@tailwindplus/elements": "0.0.0-insiders.98ea4bc",
    "clsx": "^2.1.1",
    "next": "16.2.11",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.8",
    "brace-expansion@1.1.15": "1.1.16",
    "brace-expansion@2.0.3": "2.1.2",
    "fast-uri": "3.1.4",
    "hono": "4.12.31",
    "js-yaml": "4.3.0",
    "body-parser": "2.3.0",
    "sharp": "0.35.3"
  }
}
