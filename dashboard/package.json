{
  "name": "clawql-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-env-catalog.mjs && node scripts/generate-provider-catalog.mjs",
    "prebuild": "node scripts/generate-env-catalog.mjs && node scripts/generate-provider-catalog.mjs",
    "dev": "next dev --port 3040 --webpack",
    "build": "next build --webpack",
    "start": "next start --port 3040",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.mjs\" --max-warnings 0",
    "catalog": "node scripts/generate-env-catalog.mjs && node scripts/generate-provider-catalog.mjs",
    "test:e2e": "playwright test",
    "test:e2e:k8s": "CLAWQL_DASHBOARD_E2E=1 playwright test",
    "test": "vitest run && npm run test:scripts",
    "test:unit": "vitest run",
    "test:scripts": "node --test scripts/openclaw-chat-enrich.test.mjs scripts/openclaw-reply-from-json.test.mjs",
    "openclaw:chat-bridge": "node scripts/openclaw-chat-bridge.mjs",
    "test:chat-enrich": "node --test scripts/openclaw-chat-enrich.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-progress": "^1.1.7",
    "@shadcn/react": "^0.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "clawql-api": "file:../packages/clawql-api",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.11",
    "postcss": "^8.5.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.0.14",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "js-yaml": "4.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@hono/node-server": "2.0.11",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@5": "5.0.8",
    "fast-uri": "3.1.4",
    "hono": "4.12.31",
    "body-parser": "2.3.0",
    "sharp": "0.35.3"
  }
}
