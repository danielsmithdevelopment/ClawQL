  "private": true,
  "scripts": {
    "predev": "node scripts/generate-env-catalog.mjs",
    "prebuild": "node scripts/generate-env-catalog.mjs",
    "dev": "next dev --port 3040 --webpack",
    "build": "next build --webpack",
    "start": "next start --port 3040",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.mjs\" --max-warnings 0",
    "catalog": "node scripts/generate-env-catalog.mjs",
    "test:e2e": "playwright test",
    "test:e2e:k8s": "CLAWQL_DASHBOARD_E2E=1 playwright test",
    "openclaw:chat-bridge": "node scripts/openclaw-chat-bridge.mjs"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.7",
    "@tailwindcss/postcss": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.6",
    "postcss": "^8.5.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.0.14",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.6"
  },
  "overrides": {
