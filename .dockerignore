# Build context for `docker build -f docker/Dockerfile .` and `apps/dashboard/Dockerfile` (repo root).
node_modules
# Workspace installs under packages/* conflict with `COPY packages ./packages` in the Dockerfile.
packages/**/node_modules
dist
.git
.github
.cursor
.env
.env.*
# apps/dashboard/Dockerfile COPYs `.env.example` for env-catalog generation at build time.
!.env.example
*.log
.DS_Store
# Do not ignore `docs` or `/docs/**` here. A basename `docs` pattern also excludes
# `apps/docs` (docs.clawql.com), which the website image COPYs from the repo-root context.
# Exclude scripts, but keep the single catalog re-export the dashboard image needs.
# (Bare `scripts` blocks negation of children — use `scripts/**` + `!` exceptions.)
scripts/**
!scripts/kubernetes/
!scripts/kubernetes/provider-vault-key-catalog.ts
coverage
**/*.test.ts
**/__tests__
