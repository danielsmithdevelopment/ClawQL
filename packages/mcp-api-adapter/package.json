{
  "name": "mcp-api-adapter",
  "version": "0.6.0",
  "description": "Standalone adapter: point at any MCP server and instantly serve OpenAPI + GraphQL + Streamable HTTP /mcp + gRPC + WebSocket + HTMX /mcp-ui, plus gen-cli for a thin tool CLI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mcp-api-adapter": "bin/mcp-api-adapter.mjs",
    "mcp-openapi-gateway": "bin/mcp-api-adapter.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "graphql",
    "grpc",
    "adapter",
    "api",
    "clawql"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/mcp-api-adapter"
  },
  "bugs": {
    "url": "https://github.com/danielsmithdevelopment/ClawQL/issues"
  },
  "homepage": "https://github.com/danielsmithdevelopment/ClawQL/tree/main/packages/mcp-api-adapter#readme",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "graphql": "^16.14.0",
    "jose": "^6.2.10",
    "mcp-grpc-transport": "1.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1",
    "zod": "^3.24.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "start": "node bin/mcp-api-adapter.mjs"
  }
}
