{
  "name": "clawql-api",
  "version": "7.0.0",
  "description": "ClawQL composition root: plugin registry, search/execute Effect pipelines (#308)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mcp/tool-shape-log": {
      "types": "./dist/mcp/tool-shape-log.d.ts",
      "import": "./dist/mcp/tool-shape-log.js",
      "require": "./dist/mcp/tool-shape-log.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@graphql-mesh/utils": "^0.104.36",
    "@smithy/protocol-http": "^5.5.8",
    "@smithy/signature-v4": "^5.6.4",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@omnigraph/openapi": "^0.109.51",
    "clawql-auth": "7.0.0",
    "clawql-core": "7.0.0",
    "effect": "^3.21.4",
    "graphql": "^16.14.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "node-fetch": "^3.3.2",
    "prom-client": "^15.1.3",
    "swagger2openapi": "^7.0.8",
    "yaml": "^2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-api"
  },
  "keywords": [
    "clawql",
    "effect",
    "mcp",
    "api",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
