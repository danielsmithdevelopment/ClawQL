// Generated by clawql-observability Alloy config generator (Phase 3b).
// Registry is source of truth — do not hand-edit generated exporter blocks.

logging {
  level = "info"
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout         = "5s"
  send_batch_size = 1000

  output {
    metrics = [otelcol.exporter.prometheus.lgtm_mimir.input]
    logs    = [otelcol.exporter.otlphttp.lgtm_loki.input]
    traces  = [otelcol.exporter.otlphttp.lgtm_tempo.input]
  }
}

otelcol.exporter.otlphttp "lgtm_loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}
otelcol.exporter.prometheus "lgtm_mimir" {
  forward_to = [prometheus.remote_write.remote_write_lgtm_mimir.receiver]
}
prometheus.remote_write "remote_write_lgtm_mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
    headers = {
      "X-Scope-OrgID" = "anonymous",
    }
  }
}
otelcol.exporter.otlphttp "lgtm_tempo" {
  client {
    endpoint = "http://tempo:4318"
  }
}

// Faro browser ingest (Worker proxy forwards here privately).
faro.receiver "frontend" {
  server {
    listen_address       = "0.0.0.0"
    listen_port          = 8027
    cors_allowed_origins = ["*"]
  }

  output {
    logs   = [loki.write.faro_lgtm_loki.receiver]
    traces = [otelcol.processor.batch.default.input]
  }
}

loki.write "faro_lgtm_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
