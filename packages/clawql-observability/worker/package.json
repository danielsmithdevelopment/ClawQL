{
  "name": "clawql-observability-faro-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker — JWT-gated Grafana Faro ingest proxy for clawql-observability Phase 2",
  "license": "Apache-2.0",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --platform=neutral --target=es2022 --conditions=worker",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "esbuild": "^0.25.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.76.0"
  },
  "engines": {
    "node": ">=22"
  }
}
