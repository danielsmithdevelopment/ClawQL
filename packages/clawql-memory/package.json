      "types": "./dist/db/artifacts.d.ts",
      "import": "./dist/db/artifacts.js",
      "require": "./dist/db/artifacts.cjs"
    },
    "./db/postgres-migrations": {
      "types": "./dist/db/postgres-migrations.d.ts",
      "import": "./dist/db/postgres-migrations.js",
      "require": "./dist/db/postgres-migrations.cjs"
    },
    "./db/memory-db": {
      "types": "./dist/db/memory-db.d.ts",
      "import": "./dist/db/memory-db.js",
      "require": "./dist/db/memory-db.cjs"
    },
    "./vector/pgvector": {
      "types": "./dist/vector/pgvector.d.ts",
      "import": "./dist/vector/pgvector.js",
      "require": "./dist/vector/pgvector.cjs"
    },
    "./vault/provider-index": {
      "types": "./dist/vault/provider-index.d.ts",
      "import": "./dist/vault/provider-index.js",
      "require": "./dist/vault/provider-index.cjs"
    },
    "./okf": {
      "types": "./dist/okf/index.d.ts",
      "import": "./dist/okf/index.js",
      "require": "./dist/okf/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./sync/vault-sync-hooks": {
      "types": "./dist/sync/vault-sync-hooks.d.ts",
      "import": "./dist/sync/vault-sync-hooks.js",
      "require": "./dist/sync/vault-sync-hooks.cjs"
    },
    "./ontology": {
      "types": "./dist/ontology/index.d.ts",
      "import": "./dist/ontology/index.js",
      "require": "./dist/ontology/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "clawql-api": "0.1.0",
    "clawql-codegraph": "0.1.0",
    "clawql-core": "0.1.0",
    "clawql-pageindex": "0.1.0",
    "effect": "^3.21.4",
    "fflate": "^0.8.2",
    "pg": "^8.21.0",
    "sql.js": "^1.14.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/sql.js": "^1.4.11",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-memory"
  },
  "keywords": [
    "clawql",
    "memory",
    "vault",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
