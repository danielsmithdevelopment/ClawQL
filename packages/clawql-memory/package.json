{
  "name": "clawql-memory",
  "version": "0.1.0",
  "description": "ClawQL vault memory primitives: chunking, artifact cache, ingest helpers (#307 order 4)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "clawql-memory": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vault/config": {
      "types": "./dist/vault/config.d.ts",
      "import": "./dist/vault/config.js",
      "require": "./dist/vault/config.cjs"
    },
    "./vault/utils": {
      "types": "./dist/vault/utils.d.ts",
      "import": "./dist/vault/utils.js",
      "require": "./dist/vault/utils.cjs"
    },
    "./vault/slug-index": {
      "types": "./dist/vault/slug-index.d.ts",
      "import": "./dist/vault/slug-index.js",
      "require": "./dist/vault/slug-index.cjs"
    },
    "./ingest/slug": {
      "types": "./dist/ingest/slug.d.ts",
      "import": "./dist/ingest/slug.js",
      "require": "./dist/ingest/slug.cjs"
    },
    "./ingest/hashes": {
      "types": "./dist/ingest/hashes.d.ts",
      "import": "./dist/ingest/hashes.js",
      "require": "./dist/ingest/hashes.cjs"
    },
    "./ingest/enterprise-citations": {
      "types": "./dist/ingest/enterprise-citations.d.ts",
      "import": "./dist/ingest/enterprise-citations.js",
      "require": "./dist/ingest/enterprise-citations.cjs"
    },
    "./ingest/ingest": {
      "types": "./dist/ingest/ingest.d.ts",
      "import": "./dist/ingest/ingest.js",
      "require": "./dist/ingest/ingest.cjs"
    },
    "./recall/recall": {
      "types": "./dist/recall/recall.d.ts",
      "import": "./dist/recall/recall.js",
      "require": "./dist/recall/recall.cjs"
    },
    "./recall/onyx-recall": {
      "types": "./dist/recall/onyx-recall.d.ts",
      "import": "./dist/recall/onyx-recall.js",
      "require": "./dist/recall/onyx-recall.cjs"
    },
    "./embedding/embedding": {
      "types": "./dist/embedding/embedding.d.ts",
      "import": "./dist/embedding/embedding.js",
