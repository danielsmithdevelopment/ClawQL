{
  "name": "clawql-gdp",
  "version": "0.1.0",
  "description": "Ghosts of Departed Proofs (gdp-ts) Effect wrappers and branded ids for ClawQL compile-time authorization",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gdp-ts/core": "^0.1.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-gdp"
  },
  "homepage": "https://github.com/danielsmithdevelopment/ClawQL/tree/main/packages/clawql-gdp",
  "bugs": {
    "url": "https://github.com/danielsmithdevelopment/ClawQL/issues"
  },
  "keywords": [
    "gdp-ts",
    "ghosts-of-departed-proofs",
    "authorization",
    "effect",
    "clawql"
  ],
  "publishConfig": {
    "access": "public"
  }
}
