{
  "name": "clawql-audit",
  "version": "0.1.0",
  "description": "Tamper-evident WORM audit trail for AI agent deployments",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./storage/sqlite": {
      "types": "./dist/storage/sqlite.d.ts",
      "import": "./dist/storage/sqlite.js",
      "require": "./dist/storage/sqlite.cjs"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js",
      "require": "./dist/storage/s3.cjs"
    },
    "./storage/memory": {
      "types": "./dist/storage/memory.d.ts",
      "import": "./dist/storage/memory.js",
      "require": "./dist/storage/memory.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "clawql-merkle": "0.1.0",
    "effect": "^3.21.4"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-audit"
  },
  "keywords": [
    "audit-trail",
    "worm",
    "ai-agents",
    "compliance",
    "merkle",
    "tamper-evident"
  ],
  "publishConfig": {
    "access": "public"
  }
}
