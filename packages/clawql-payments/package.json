{
  "name": "clawql-payments",
  "version": "7.0.0",
  "description": "ClawQL payments layer: Stripe billing, x402 micropayments, MPP discovery/runtime, managed plan entitlements, and WORM-auditable payment events",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./stripe": {
      "types": "./dist/stripe/index.d.ts",
      "import": "./dist/stripe/index.js",
      "require": "./dist/stripe/index.cjs"
    },
    "./x402": {
      "types": "./dist/x402/index.d.ts",
      "import": "./dist/x402/index.js",
      "require": "./dist/x402/index.cjs"
    },
    "./plans": {
      "types": "./dist/plans/index.d.ts",
      "import": "./dist/plans/index.js",
      "require": "./dist/plans/index.cjs"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js",
      "require": "./dist/audit/index.cjs"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js",
      "require": "./dist/discovery/index.cjs"
    },
    "./mpp": {
      "types": "./dist/mpp/index.d.ts",
      "import": "./dist/mpp/index.js",
      "require": "./dist/mpp/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "clawql-payments": "bin/clawql-payments.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clawql-api": "7.0.0",
    "clawql-core": "7.0.0",
    "effect": "^3.21.4",
    "stripe": "^22.3.1",
    "pg": "^8.21.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "mppx": "^0.8.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-payments"
  },
  "keywords": [
    "clawql",
    "payments",
    "stripe",
    "x402",
    "micropayments",
    "billing"
  ],
  "publishConfig": {
    "access": "public"
  }
}
