{
  "name": "clawql-auth",
  "version": "7.2.0",
  "description": "ClawQL gateway auth (noAuth/apiKey/oidc JWT consumer), inbound MCP OAuth 2.1 AS + EMA/ID-JAG, issued API keys, ATR claims, step-up TOTP/WebAuthn, outbound OAuth token store with mutex refresh",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts packages/clawql-auth"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@smithy/protocol-http": "^5.5.16",
    "@smithy/signature-v4": "^5.6.9",
    "@types/express": "^5.0.6",
    "effect": "^3.21.4",
    "express-rate-limit": "^8.5.2",
    "jose": "^6.2.8",
    "viem": "^2.55.4"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "express": ">=4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@simplewebauthn/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "@types/node": "^26.1.1",
    "clawql-audit": "7.2.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-auth"
  },
  "keywords": [
    "clawql",
    "auth",
    "atr",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
