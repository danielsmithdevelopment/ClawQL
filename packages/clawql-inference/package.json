{
  "name": "clawql-inference",
  "version": "7.1.0",
  "description": "ClawQL inference gateway: model tier escalation, provider adapters, semantic cache, and WORM-auditable observability (foundation \u2014 epic #556 / #560)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "import": "./dist/routing/index.js",
      "require": "./dist/routing/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./api/server": {
      "types": "./dist/api/server.d.ts",
      "import": "./dist/api/server.js",
      "require": "./dist/api/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "clawql-inference": "bin/clawql-inference.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "clawql-api": "7.1.0",
    "clawql-core": "7.1.0",
    "clawql-payments": "7.1.0",
    "effect": "^3.21.4",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-inference"
  },
  "keywords": [
    "clawql",
    "inference",
    "llm",
    "gateway",
    "routing",
    "ollama"
  ],
  "publishConfig": {
    "access": "public"
  }
}
