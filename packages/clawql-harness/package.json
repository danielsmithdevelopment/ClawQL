{
  "name": "clawql-harness",
  "version": "7.2.0",
  "description": "ClawQL execution-loop harness — plugin registry, tool/WORM bridges, Ouroboros and OpenCode2 plugins",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugins/ouroboros": {
      "types": "./dist/plugins/ouroboros/index.d.ts",
      "import": "./dist/plugins/ouroboros/index.js",
      "require": "./dist/plugins/ouroboros/index.cjs"
    },
    "./plugins/opencode2": {
      "types": "./dist/plugins/opencode2/index.d.ts",
      "import": "./dist/plugins/opencode2/index.js",
      "require": "./dist/plugins/opencode2/index.cjs"
    },
    "./bench": {
      "types": "./dist/bench/harness-bench.d.ts",
      "import": "./dist/bench/harness-bench.js",
      "require": "./dist/bench/harness-bench.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clawql-audit": "7.2.0",
    "clawql-core": "7.2.0",
    "clawql-ouroboros": "7.2.0",
    "effect": "^3.21.4"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/sdk": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "plugins",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-harness"
  },
  "keywords": [
    "clawql",
    "harness",
    "ouroboros",
    "opencode",
    "execution-loop",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
