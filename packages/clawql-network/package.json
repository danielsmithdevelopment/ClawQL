{
  "name": "clawql-network",
  "version": "0.1.0",
  "description": "ClawQL private mesh (Headscale) + governed ephemeral transport (Tailcat) with selector and audit hooks",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./init": {
      "types": "./dist/init/index.d.ts",
      "import": "./dist/init/index.js",
      "require": "./dist/init/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts packages/clawql-network"
  },
  "dependencies": {
    "clawql-api": "0.1.0",
    "clawql-core": "0.1.0",
    "effect": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-network"
  },
  "keywords": [
    "clawql",
    "headscale",
    "tailscale",
    "tailcat",
    "mesh",
    "network"
  ],
  "publishConfig": {
    "access": "public"
  }
}
