{
  "name": "clawql-documents",
  "version": "7.1.0",
  "description": "ClawQL document ingest pipeline: external knowledge import into vault (#307 order 5)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ingest/external-ingest": {
      "types": "./dist/ingest/external-ingest.d.ts",
      "import": "./dist/ingest/external-ingest.js",
      "require": "./dist/ingest/external-ingest.cjs"
    },
    "./ingest/url-format": {
      "types": "./dist/ingest/url-format.d.ts",
      "import": "./dist/ingest/url-format.js",
      "require": "./dist/ingest/url-format.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clawql-api": "7.1.0",
    "clawql-core": "7.1.0",
    "clawql-memory": "7.1.0",
    "effect": "^3.21.4",
    "node-html-markdown": "^2.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-documents"
  },
  "keywords": [
    "clawql",
    "documents",
    "ingest",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
