{
  "name": "clawql-agents",
  "version": "0.1.0",
  "description": "ClawQL hardened adapters for open-source agents (Cline, OpenClaw, Hermes)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clawql-audit": "0.1.0",
    "clawql-auth": "0.1.0",
    "effect": "^3.21.4"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.0",
    "hermes-agent": ">=0.14.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    },
    "hermes-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1"
  },
  "files": [
    "dist",
    "python",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsmithdevelopment/ClawQL.git",
    "directory": "packages/clawql-agents"
  },
  "keywords": [
    "clawql",
    "agents",
    "cline",
    "worm",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
