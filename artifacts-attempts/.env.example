# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ARTIFACTS_NAMESPACE=attempts

# Decisions (ClawQL gateway or OpenAI-compatible)
DECISIONS_URL=
DECISIONS_API_KEY=
DECISIONS_MIN_CONFIDENCE=0.9

# Arweave / Turbo (never commit the JWK)
ARWEAVE_JWK=
ARWEAVE_DRY_RUN=1

# Live e2e
ATTEMPTS_API=http://127.0.0.1:8787
ATTEMPTS_E2E=0

# x402 unlock (optional closing beat — after live Artifacts works)
UNLOCK_PAY_TO=
UNLOCK_PRICE_ATOMIC=10000
UNLOCK_NETWORK=base-sepolia
UNLOCK_DRY_RUN=1
UNLOCK_CONTENT_KEY_HEX=
X402_FACILITATOR_URL=https://x402.org/facilitator
