node_modules/

# Build output
dist/

# Environment and secrets
.env
.env.*
!.env.example
docker/compose/lending.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE / editors
.idea/
.vscode/
# Cursor MCP — commit `.cursor/mcp.json` for IDE + Cloud Agents (no secrets; CLAWQL_HOME only).
# Keep `.cursor/mcp.json.example` in sync when changing the template.
*.swp
*.swo
*~

# Bun
.bun/

# TypeScript
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# ESLint / Prettier (local + CI caches)
.eslintcache
.prettier-cache

# Optional local notes
*.local.md

# Optional bulk download of every Google Discovery doc (can be huge)
providers/google/discovery-cache/

# Kustomize local overlay: generated when CLAWQL_LOCAL_K8S_INSTALLER=kustomize
docker/kustomize/overlays/local/patch-mcp-vault-hostpath.json

# Helm umbrella chart packaged dependencies (regenerate: helm dependency update)
charts/*/charts/*.tgz
clawql-mcp-*.tgz
.package.json.prepack-backup

# Ontology generate output
generated/

# clawql-release rift workspaces
.rifts/

# clawql-release local tooling (keys, escrow, staging, e2e report)
.clawql/

# CI e2e-only release bundle (do not commit)
releases/v0.0.0-e2e/

# Python (OpenBench validators / adapters)
__pycache__/

# Managed Edge Gateway local runtime
examples/managed-gateway/.env
examples/managed-gateway/data/
