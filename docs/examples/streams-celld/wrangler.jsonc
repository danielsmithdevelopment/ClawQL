{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clawql-streams-celld-skeleton",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "INFERENCE_URL": "http://127.0.0.1:8080",
    // Out-of-process search/execute/memory via Streamable HTTP (sidecar mode).
    "CLAWQL_MCP_URL": "",
    // Optional mcp-api-adapter REST origin (POST /{tool}); empty → deferred.
    "CLAWQL_MCP_ADAPTER_URL": "",
    // Optional clawql-audit HTTP origin (POST /entries); empty → deferred compliance WORM.
    "CLAWQL_AUDIT_WORM_URL": "",
    "CLAWQL_AUDIT_API_KEY": "",
    // Default on: AgentSessionDO search/execute use CoreToolsDO. Escape: "0" → Bun host CLAWQL_MCP_URL.
    "CLAWQL_CORE_IN_CELLD": "1",
    // REST origin for CoreToolsDO execute (e.g. mock pets http://127.0.0.1:PORT).
    "CLAWQL_CORE_UPSTREAM": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "GatewayDO" },
      { "name": "SUBSCRIPTION", "class_name": "SubscriptionDO" },
      { "name": "AGENT_SESSION", "class_name": "AgentSessionDO" },
      { "name": "CORE_TOOLS", "class_name": "CoreToolsDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GatewayDO", "SubscriptionDO", "AgentSessionDO"]
    },
    {
      "tag": "v2-core-tools",
      "new_sqlite_classes": ["CoreToolsDO"]
    }
  ]
}
